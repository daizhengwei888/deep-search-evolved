{
  "platform": "zcode",
  "planner_entrypoint": "python3 scripts/plan-query.py \"<query>\" --platform zcode --pretty",
  "search_entrypoint": "bash scripts/swarm-search.sh --plan <plan.json>",
  "worker_surface": "ZCode subagents (no nested delegation) + shell",
  "host_native_tools": ["web_search", "web_fetch"],
  "optional_mcp_servers": ["web-search-prime", "web-reader"],
  "max_description_chars": 1024,
  "max_skill_body_bytes": 102400,
  "provider_map_source": "config/capability-registry.json#capabilities[].platform_providers.zcode"
}
